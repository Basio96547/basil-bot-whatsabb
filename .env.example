# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. .env نفسه لا يُرفع لأي مكان (بند 9 و11 بالخطة).

PORT=3000
DATA_DIR=./data

# مفتاح API لكل مشروع مسجّل في config/projects.json — الاسم PROJECT_API_KEY_<ID بأحرف كبيرة>
PROJECT_API_KEY_STORE=change-me-store-key
PROJECT_API_KEY_QAREEB=change-me-qareeb-key

# يستخدم لتجزئة (hash) أكواد الـ OTP قبل تخزينها — قيمة عشوائية طويلة، غيّرها ولا تشاركها
OTP_HASH_SECRET=change-me-otp-secret

# رقم واتساب الإرسال (للتوثيق فقط، الربط الفعلي عبر مسح QR أول تشغيل)
WHATSAPP_NUMBER=

# نسخة احتياطية لجلسة واتساب على Cloudflare R2 (بند 8، نقطة 6)
SESSION_BACKUP_ENCRYPTION_KEY=change-me-32-byte-hex-or-longer
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sms-api-session-backup

# مزوّد SMS — اتركه فارغاً لحد ما تحدد مزوّداً فعلياً (بند 6). الخدمة تعمل بواتساب فقط بدونه.
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=

# الصمود تحت الضغط (بند 9)
QUEUE_MAX_PENDING=5000
SEND_BATCH_SIZE=20
SEND_MIN_DELAY_MS=3000
SEND_MAX_DELAY_MS=9000

# الحماية من حظر الرقم المُرسِل.
#
# الحدود لكل رقم مستلم (otpMaxPerDay، resendCooldownMinutes في
# config/projects.json) تحدّ ما يستلمه شخص واحد. أما هذه فتحدّ ما يُصدره
# الحساب كله في الساعة — وهو البعد الذي يحكم عليه واتساب فعلاً: مئات الرسائل
# في الساعة من عميل غير رسمي تُقرأ كبثّ جماعي مهما وُزّعت بلطف على المستلمين.
# هذا الحساب سبق أن قُيّد فعلاً (RESTRICT_ALL_COMPANIONS في 2026-09-03)،
# فالسقف منخفض بقصد: أعلى بكثير من الحركة الحقيقية، وأدنى بكثير من أي نمط
# جماعي. تجاوزه يؤخّر ولا يُسقط — الطابور يتوقف عن التصريف حتى تدور النافذة.
SEND_MAX_PER_HOUR=120

# الرقم حديث الربط أهشّ ما يكون، وهذه بالضبط حالة إعادة الربط بعد قيد.
# أول ساعاته تعمل بجزء من السقف العادي.
SEND_WARMUP_HOURS=24
SEND_WARMUP_MAX_PER_HOUR=30

# نبضة إبقاء الاتصال. الافتراضي في Baileys ٣٠ ثانية؛ مضاعفتها تنصّف إيقاظ
# راديو الجوال. لا ترفعها كثيراً: الخادم يُسقط المقبس الخامل، وكل إعادة اتصال
# على عميل غير رسمي إشارة حظر بحدّ ذاتها.
KEEP_ALIVE_INTERVAL_MS=60000
